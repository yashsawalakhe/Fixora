NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/fixora.sqlite

# Optional Gemini-powered investigation explanations.
GEMINI_API_KEY=

# Optional SMTP delivery for password reset links. Without SMTP, development
# links are written to the server console; production does not log reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
